# Скопируйте в .env и заполните.
# Локально: docker compose up -d (PostgreSQL на порту 5433)

# Владелец БД: под ним dbmate применяет миграции (pnpm db:migrate).
# Для Neon — прямой адрес без пулера. В Vercel эту переменную НЕ добавляйте:
# миграции продакшена выполняет CI из секрета GitHub PRODUCTION_DATABASE_URL.
# Локально: postgres://postgres:postgres@localhost:5433/dashboard?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5433/dashboard?sslmode=disable

# Пользователь приложения, член роли dashboard_app (только DML, без DDL).
# Выдает команда: pnpm db:create-user. На Vercel — адрес пулера Neon (хост с -pooler).
POSTGRES_URL=

# Секрет Better Auth (не короче 32 символов): `npx auth secret` или `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Адрес приложения. Локально обязателен; на Vercel можно не задавать —
# он определяется по системным переменным Vercel (lib/deployment.ts)
BETTER_AUTH_URL=http://localhost:3000
